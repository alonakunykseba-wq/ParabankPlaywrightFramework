<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Parabank Playwright Suite" parallel="methods" thread-count="2" verbose="2">
    <test name="TC-01: verifyValidUserRegistrationTest">
        <classes>
            <class name="com.parabank.tests.RegistrationTest">
            <methods>
                <include name ="verifyValidUserRegistrationTest"/>
            </methods>
            </class>
        </classes>
    </test>
    <test name="TC-02: verifyInvalidRegistrationValidationsTest">
        <classes>
            <class name="com.parabank.tests.RegistrationTest">
                <methods>
                    <include name ="verifyInvalidRegistrationValidationsTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="TC-03: verifyValidUserLoginTest">
        <classes>
            <class name="com.parabank.tests.LoginTest">
                <methods>
                    <include name ="verifyValidUserLoginTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="TC-04: verifyInvalidLoginCredentialsTest">
        <classes>
            <class name="com.parabank.tests.LoginTest">
                <methods>
                    <include name ="verifyInvalidLoginCredentialsTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="TC-05: verifyOpenNewCheckingAccountTest">
        <classes>
            <class name="com.parabank.tests.AccountManagementTest">
                <methods>
                    <include name ="verifyOpenNewCheckingAccountTest"/>
                </methods>
            </class>
        </classes>
    </test>
    <test name="TC-06: verifyNewSavingsAccountAppearsInOverviewTest">
        <classes>
            <class name="com.parabank.tests.AccountManagementTest">
                <methods>
                    <include name ="verifyNewSavingsAccountAppearsInOverviewTest"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>